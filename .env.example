# Copiar para .env.local e preencher. Nunca fazer commit do .env.local.

# URL pública da app (local: http://localhost:3000; produção: https://app.oseudominio.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para proteger o endpoint de sincronização (/api/cron/sync)
CRON_SECRET=

# Shopify (Partners → App → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Meta Ads (developers.facebook.com → App)
META_APP_ID=
META_APP_SECRET=

# Google (Google Cloud Console → OAuth client). Usado para Google Ads e Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API Center → Developer token
GOOGLE_ADS_DEVELOPER_TOKEN=
